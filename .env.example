# Where the LogiQuote dashboard is running (local or staging). Never point at production data.
DEMO_URL=http://localhost:3000
# Optional: pin the inbox thread used in the screen flows (defaults to the first row).
DEMO_THREAD_ID=
# Allow flows to click mutating buttons (Approve, Send). Leave false unless the DB is a disposable demo DB.
DEMO_ALLOW_MUTATIONS=false

# Free key from https://www.pexels.com/api/
PEXELS_API_KEY=
# https://aistudio.google.com — used by storyboard.ts (optional) and stills.ts
GEMINI_API_KEY=

# Recording
RECORD_DISPLAY=:99
RECORD_ZOOM=1.25
